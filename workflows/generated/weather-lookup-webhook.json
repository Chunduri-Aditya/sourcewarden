{
  "name": "weather-lookup-webhook",
  "nodes": [
    {
      "id": "webhook-trigger",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "weather-lookup",
        "responseMode": "responseNode",
        "authentication": "headerAuth",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "PLACEHOLDER_CONFIGURE_ON_TARGET_INSTANCE",
          "name": "weather-lookup-webhook-shared-secret"
        }
      },
      "webhookId": "f75030af-1325-48cd-b37e-44473611c191"
    },
    {
      "id": "if-validate",
      "name": "Has lat/lon",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        240,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-lat",
              "leftValue": "={{ $json.body.latitude }}",
              "rightValue": "",
              "operator": {
                "type": "any",
                "operation": "exists"
              }
            },
            {
              "id": "cond-lon",
              "leftValue": "={{ $json.body.longitude }}",
              "rightValue": "",
              "operator": {
                "type": "any",
                "operation": "exists"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "http-weather",
      "name": "Fetch weather",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        480,
        -100
      ],
      "parameters": {
        "method": "GET",
        "url": "https://api.open-meteo.com/v1/forecast",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "latitude",
              "value": "={{ $json.body.latitude }}"
            },
            {
              "name": "longitude",
              "value": "={{ $json.body.longitude }}"
            },
            {
              "name": "current",
              "value": "temperature_2m"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "respond-success",
      "name": "Respond success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        720,
        -100
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"temperature_celsius\": $json.current.temperature_2m } }}",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "respond-error",
      "name": "Respond error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        480,
        100
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"error\": \"latitude and longitude are required\" } }}",
        "options": {
          "responseCode": 400
        }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Has lat/lon",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has lat/lon": {
      "main": [
        [
          {
            "node": "Fetch weather",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch weather": {
      "main": [
        [
          {
            "node": "Respond success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
